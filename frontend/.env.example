# Leave unset in development: the Vite dev server proxies /api and /uploads to
# http://localhost:5000, so the app and API share one origin and cookies "just work".
#
# Set this only when the API is hosted on a different origin, e.g.
# VITE_API_URL=https://api.yourcollege.edu/api
# (then also set COOKIE_SAMESITE=none and FRONTEND_URL on the backend).
VITE_API_URL=
