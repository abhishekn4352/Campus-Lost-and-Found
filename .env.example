# Used by docker-compose.yml  →  cp .env.example .env  and fill in.
JWT_SECRET=
EMAIL_USER=
EMAIL_PASS=
# Public URL people will type in the browser (needed for CORS and links in emails). Use https://… in production.
FRONTEND_URL=http://localhost:8080

# How many proxies sit between the internet and the API (needed for correct per-user rate limiting).
#   1 = only the bundled nginx (plain `docker compose up`)
#   2 = Caddy / host nginx / a load balancer terminating HTTPS in front of it
TRUST_PROXY=1

# First admin account, created by:  docker compose exec backend node scripts/seedAdmin.js
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_COLLEGE_ID=ADMIN
# Optional: push notifications. Generate with `cd backend && npm install && npm run vapid`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
