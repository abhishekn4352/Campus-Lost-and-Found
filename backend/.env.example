# ---- Required -------------------------------------------------------------
PORT=5000
MONGO_URI=mongodb://localhost:27017/campus_lost_found
# At least 32 random characters in production:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string

# Origin(s) of the website, comma-separated. Used for CORS and for links in emails.
FRONTEND_URL=http://localhost:3000

# ---- Email (OTP codes + notifications) -------------------------------------
# Gmail: enable 2-step verification, then create an "App password".
# Leave blank in development and codes are printed to the server console instead.
EMAIL_USER=
EMAIL_PASS=

# ---- Optional --------------------------------------------------------------
NODE_ENV=development
# Number of reverse proxies in front of the API (Render/Railway/Nginx = 1). Needed for correct rate limiting.
# TRUST_PROXY=1
# Where uploaded photos are stored. Point this at a persistent disk/volume in production.
# UPLOAD_DIR=/data/uploads

# ---- Push notifications (optional) -----------------------------------------
# Generate a key pair once with:  npm run vapid   — then paste both values here and keep the private one secret.
# Leave blank to switch push off (the notification buttons then hide themselves).
# Browsers only allow push on HTTPS (or http://localhost).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for push services. Must be mailto:… or an https URL. Defaults to mailto:EMAIL_USER.
# VAPID_SUBJECT=mailto:admin@yourcollege.edu

# ---- Only used by `node scripts/seedAdmin.js` ------------------------------
SEED_ADMIN_EMAIL=admin@yourcollege.edu
SEED_ADMIN_PASSWORD=choose-a-strong-password
SEED_ADMIN_NAME=Admin User
SEED_ADMIN_COLLEGE_ID=ADMIN001
SEED_ADMIN_PHONE=0000000000
